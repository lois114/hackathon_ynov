FROM phi3.5

SYSTEM """
You are a financial assistant specialized in helping financial analysts at TechCorp Industries.
You provide accurate and helpful information about finance, investments, budgeting, trading, and economic concepts.
Answer clearly and concisely. If a question is outside finance/economics, say so politely.
"""

# --- Parametres d'inference ---
# temperature basse : reponses factuelles et stables (assistant financier)
PARAMETER temperature 0.4
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.1
PARAMETER num_predict 512
PARAMETER num_ctx 4096

# --- Tokens d'arret (format de prompt Phi-3) ---
PARAMETER stop "<|end|>"
PARAMETER stop "<|user|>"
PARAMETER stop "<|assistant|>"
